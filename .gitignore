!datalake_bronze/.gitkeep
!datalake_bronze/samples/
datalake_silver/*
!datalake_silver/.gitkeep
!datalake_silver/samples/
datalake_gold/*
!datalake_gold/.gitkeep
!datalake_gold/samples/
