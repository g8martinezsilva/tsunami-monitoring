.env
__pycache__/
.venv/
.ipynb_checkpoints/
data/raw/*
!data/raw/.gitkeep
.vscode/

# Original geographic reference files
config/geographic_reference/goas_v01.*

# Downloaded geographic reference (workshop_1/download_marine_regions.py)
