# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tsunami_monitoring
POSTGRES_USER=tsunami
POSTGRES_PASSWORD=change_me

# HTTP User-Agent
HTTP_USER_AGENT=UDistrital-Team8-Tsunami-Monitoring/1.0

# Polling intervals (seconds)
USGS_POLL_SECONDS=60
TSUNAMI_GOV_POLL_SECONDS=300

# Raw landing zone and logging
RAW_DIR=datalake_bronze
LOG_LEVEL=INFO
# Airflow (Docker Compose)
# Run `id -u` and put the number here so files written by Airflow belong to you (usually 1000)
AIRFLOW_UID=1000
AIRFLOW_ADMIN_USER=airflow
AIRFLOW_ADMIN_PASSWORD=change_me
