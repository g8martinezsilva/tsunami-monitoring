# Copy to .env and fill in your own values. Never commit .env (it is git-ignored).

# PostgreSQL (Docker Compose service, Workshop 2)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tsunami
POSTGRES_USER=tsunami
POSTGRES_PASSWORD=change-me

# Identified User-Agent sent with every request (add a team contact)
HTTP_USER_AGENT=UDistrital-Team8-Tsunami-Monitoring/1.0

# Polling intervals in seconds (see config/sources.yaml)
USGS_POLL_SECONDS=60
TSUNAMI_GOV_POLL_SECONDS=300

# Raw landing zone and logging
RAW_DIR=data/raw
LOG_LEVEL=INFO
