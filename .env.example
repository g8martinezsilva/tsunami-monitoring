# PostgreSQL configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=tsunami_monitoring
POSTGRES_USER=tsunami
POSTGRES_PASSWORD=change_me

# HTTP User-Agent
HTTP_USER_AGENT=UDistrital-Team8-Tsunami-Monitoring/1.0

# Polling intervals (seconds)
USGS_POLL_SECONDS=60
TSUNAMI_GOV_POLL_SECONDS=300

# Raw landing zone and logging
RAW_DIR=data/raw
LOG_LEVEL=INFO